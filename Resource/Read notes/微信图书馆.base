views:
  - type: cards
    name: 视图
    filters:
      and:
        - file.folder.contains("read")
        - '!file.basename.contains("图书馆")'
    order:
      - file.name
      - author
      - readingTime
      - readingDate
      - progress
    sort:
      - property: file.mtime
        direction: DESC
    image: note.cover
    imageFit: contain
  - type: table
    name: 表格
